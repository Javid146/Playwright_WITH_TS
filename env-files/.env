# apiURLs[env as keyof typeof apiURLs] = return the value of apiURLs object for the key env. 
# keyof typeof apiURLs means returns the type of keys of apiURLs object. so env as keyof typeof apiURLs means env is one of the keys of apiURLs object. 
# so apiURLs[env as keyof typeof apiURLs] means returns the value of apiURLs object for the key env which is one of the keys of apiURLs object.

# [] here is not an array. It is called bracket notation, a way to access an object's property. like apiURLs.dev or apiURLs["dev"] both are same. 
# but if you want to access the property dynamically then you can use bracket notation. 
# like apiURLs[env] where env is a variable which holds the key (dev or uat or stg) of apiURLs object. so it will return the value of apiURLs object for the key env.

# if say, env is uat then currentAPIsPerEnv will return:
# {
#     booking: "https://uat-booking.example.com",
#     users: "https://uat-users.example.com"
# }

# in test if you want to use users: apiURLs["uat"].users or apiURLs.uat.users both are same. 
# but if you want to use users: currentAPIsPerEnv.users then you can use it like this.

# export const currentAPIsPerEnv = apiURLs[env as keyof typeof apiURLs];